{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootcamp 6: Setup",
      "type": "process",
      "command": "sh",
      "args": [
        "${workspaceFolder}/scripts/setup.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "${workspaceFolder}\\scripts\\setup.cmd"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
